{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Python Starter",
  "version": "0.5.0",
  "identifier": "com.example.rust-python-starter",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../../frontend",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../../frontend"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../frontend/dist",
    "additionalWatchFolders": [
      "../../../crates"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rust + Python Desktop Starter",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/python-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
